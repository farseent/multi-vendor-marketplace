# Copy to server/.env (never commit .env). Loaded by `npm run dev` / `npm start`.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Single-node replica set from docker-compose.yml; directConnection is needed because the
# replica set advertises itself as "localhost:27017".
MONGODB_URI=mongodb://localhost:27017/marketplace?directConnection=true
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
# Comma-separated exact origins allowed by CORS (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
