# Copy to server/.env (never commit .env). Loaded by `npm run dev` / `npm start`.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Single-node replica set from docker-compose.yml; directConnection is needed because the
# replica set advertises itself as "localhost:27017".
MONGODB_URI=mongodb://localhost:27017/marketplace?directConnection=true
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
# Comma-separated exact origins allowed by CORS (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# --- Phase 1: auth ---
# Required, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-32chars-min
# Optional (defaults shown). BCRYPT_COST cannot go below 12.
# REFRESH_TOKEN_TTL_DAYS=30
# BCRYPT_COST=12
# lax = frontend and API share a parent domain; none = cross-site (forces Secure cookies). See V5.
# COOKIE_SAME_SITE=lax
# Number of reverse proxies in front of the API (0 = none). Set to 1 on most PaaS hosts.
# TRUST_PROXY=0
# Only read by `npm run seed:admin -w server` (the API itself does not need these)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=MarketAdmin@123
ADMIN_SEED_NAME=Platform Admin

# --- Phase 2: image uploads (optional; without S3_BUCKET the API runs and uploads answer 503) ---
# Browser PUTs images straight to this bucket using presigned URLs (bucket CORS must allow PUT from
# CORS_ORIGINS). Credentials are the standard AWS variables, read by the AWS SDK. Never commit them:
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
S3_BUCKET=
S3_REGION=
# Optional CDN/base URL images are served from. Default: https://<bucket>.s3.<region>.amazonaws.com
# S3_PUBLIC_BASE_URL=
